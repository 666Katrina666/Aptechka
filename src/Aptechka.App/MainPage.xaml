<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Aptechka.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Aptechka.App.ViewModels"
    x:DataType="viewModels:MainViewModel"
    Title="Аптечка">

    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="OnAddClicked" Text="Добавить" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <SearchBar
            Placeholder="Название, алиас или вещество"
            Text="{Binding SearchQuery}" />

        <Grid Grid.Row="1">
            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CatalogItemRow">
                        <Grid Padding="4,10">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Name}" />
                                <Label
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Category}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label
                                    IsVisible="{Binding HasDetails}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Details}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding KeepInStock}"
                                    Text="Всегда иметь дома"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding Availability}" />
                                <Label
                                    FontSize="13"
                                    IsVisible="{Binding HasUsablePackages}"
                                    Text="{Binding UsablePackages}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label
                                    FontSize="13"
                                    IsVisible="{Binding HasNearestExpiration}"
                                    Text="{Binding NearestExpiration}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label
                                    FontSize="13"
                                    IsVisible="{Binding HasExpiredWarning}"
                                    Text="{Binding ExpiredWarning}"
                                    TextColor="#B3261E" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                MaximumWidthRequest="320"
                VerticalOptions="Center"
                Text="{Binding EmptyMessage}"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />
            <Label FontAttributes="Bold" LineBreakMode="WordWrap" Text="{Binding SyncHeadline}" />
            <Label
                LineBreakMode="WordWrap"
                Text="{Binding SyncDetail}" />
            <Label
                FontSize="12"
                IsVisible="{Binding HasLastSuccessful}"
                LineBreakMode="WordWrap"
                Text="{Binding LastSuccessfulText}"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            <BoxView HeightRequest="3" IsVisible="{Binding IsSynced}" Color="{StaticResource Primary}" />
            <BoxView HeightRequest="3" IsVisible="{Binding IsLocalChanges}" Color="{StaticResource Gray400}" />
            <BoxView HeightRequest="3" IsVisible="{Binding IsSyncing}" Color="{StaticResource Primary}" />
            <BoxView HeightRequest="3" IsVisible="{Binding IsConflict}" Color="#8A5A00" />
            <BoxView HeightRequest="3" IsVisible="{Binding IsError}" Color="#B3261E" />

            <Button Command="{Binding SyncCommand}" Text="Синхронизировать" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Command="{Binding ToggleGitHubSettingsCommand}" Text="Настройки GitHub" />
            <VerticalStackLayout IsVisible="{Binding AreGitHubSettingsExpanded}" Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Style="{StaticResource Body}" Text="Владелец" />
                        <Entry Text="{Binding Owner}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Style="{StaticResource Body}" Text="Репозиторий" />
                        <Entry Text="{Binding Repository}" />
                    </VerticalStackLayout>
                </Grid>

                <Label Style="{StaticResource Body}" Text="Ветка" />
                <Entry Text="{Binding Branch}" />

                <Label Style="{StaticResource Body}" Text="GitHub token" />
                <Entry
                    IsPassword="True"
                    Placeholder="github_pat_..."
                    Text="{Binding TokenInput}" />

                <Label
                    FontSize="12"
                    Text="{Binding TokenStatus}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

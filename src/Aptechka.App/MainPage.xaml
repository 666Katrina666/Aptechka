<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Aptechka.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Aptechka.App.ViewModels"
    x:DataType="viewModels:MainViewModel"
    Title="Аптечка">

    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="OnAddClicked" Text="Добавить" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <SearchBar
            Placeholder="Название, алиас или вещество"
            Text="{Binding SearchQuery}" />

        <Grid Grid.Row="1">
            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CatalogItemRow">
                        <Grid Padding="4,10">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Name}" />
                                <Label
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Category}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label
                                    IsVisible="{Binding HasDetails}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Details}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding KeepInStock}"
                                    Text="Всегда иметь дома"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                MaximumWidthRequest="320"
                VerticalOptions="Center"
                Text="{Binding EmptyMessage}"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />
            <Label FontAttributes="Bold" Text="GitHub-синхронизация" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Style="{StaticResource Body}" Text="Владелец" />
                    <Entry Text="{Binding Owner}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Style="{StaticResource Body}" Text="Репозиторий" />
                    <Entry Text="{Binding Repository}" />
                </VerticalStackLayout>
            </Grid>

            <Label Style="{StaticResource Body}" Text="Ветка" />
            <Entry Text="{Binding Branch}" />

            <Label Style="{StaticResource Body}" Text="GitHub token" />
            <Entry
                IsPassword="True"
                Placeholder="github_pat_..."
                Text="{Binding TokenInput}" />

            <Label
                FontSize="12"
                Text="{Binding TokenStatus}"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <Button Command="{Binding SyncCommand}" Text="Синхронизировать" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label
                LineBreakMode="WordWrap"
                Text="{Binding Status}"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

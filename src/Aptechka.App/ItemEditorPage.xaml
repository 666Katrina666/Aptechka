<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Aptechka.App.ItemEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Aptechka.App.ViewModels"
    x:DataType="viewModels:ItemEditorViewModel"
    Title="{Binding Title}">

    <ScrollView AutomationId="ItemEditor.Page">
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="720">
            <Label
                IsVisible="{Binding HasError}"
                Text="{Binding ErrorMessage}"
                TextColor="#B3261E" />

            <Label Style="{StaticResource Body}" Text="Название" />
            <Entry AutomationId="ItemEditor.Name" Placeholder="Например, Ибупрофен" Text="{Binding Name}" />

            <Label Style="{StaticResource Body}" Text="Алиасы через запятую" />
            <Entry Placeholder="Нурофен" Text="{Binding Aliases}" />

            <Label Style="{StaticResource Body}" Text="Категория" />
            <Picker ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" />

            <Label Style="{StaticResource Body}" Text="Действующие вещества через запятую" />
            <Entry Placeholder="ибупрофен" Text="{Binding ActiveIngredients}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Style="{StaticResource Body}" Text="Форма" />
                    <Entry AutomationId="ItemEditor.Form" Placeholder="таблетки" Text="{Binding Form}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Style="{StaticResource Body}" Text="Дозировка / концентрация" />
                    <Entry AutomationId="ItemEditor.Strength" Placeholder="200 мг" Text="{Binding Strength}" />
                </VerticalStackLayout>
            </Grid>

            <Label Style="{StaticResource Body}" Text="Описание" />
            <Editor
                AutoSize="TextChanges"
                MinimumHeightRequest="88"
                Placeholder="Короткая личная заметка"
                Text="{Binding Description}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" VerticalOptions="Center" Text="Всегда иметь дома" />
                <Switch AutomationId="ItemEditor.KeepInStock" Grid.Column="1" IsToggled="{Binding KeepInStock}" />
            </Grid>

            <VerticalStackLayout IsVisible="{Binding IsEditing}" Spacing="12">
                <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />
                <Label FontAttributes="Bold" Text="Упаковки" />
                <Label
                    IsVisible="{Binding HasNoPackages}"
                    Text="Упаковок пока нет"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Button
                    AutomationId="ItemEditor.AddPackage"
                    Clicked="OnAddPackageClicked"
                    IsEnabled="{Binding CanMutatePackages}"
                    Text="Добавить упаковку" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Packages}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:PackageListRow">
                            <Border Padding="12" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}">
                                <VerticalStackLayout AutomationId="ItemEditor.PackageRow" Spacing="6">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPackageTapped" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label FontAttributes="Bold" Text="{Binding Title}" />
                                    <Label Text="{Binding StockState}" />
                                    <Label Text="{Binding Expiration}" />
                                    <Label
                                        IsVisible="{Binding IsExpired}"
                                        Text="Просрочена"
                                        TextColor="#B3261E" />
                                    <Label
                                        IsVisible="{Binding HasOpened}"
                                        Text="{Binding Opened}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button
                                            Grid.Column="0"
                                            Clicked="OnMarkLowClicked"
                                            FontSize="13"
                                            Text="Заканчивается" />
                                        <Button
                                            Grid.Column="1"
                                            Clicked="OnMarkDepletedClicked"
                                            FontSize="13"
                                            Text="Пачка закончилась" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button AutomationId="ItemEditor.Save" Command="{Binding SaveCommand}" Text="Сохранить" />
            <Button
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                Clicked="OnArchiveClicked"
                IsVisible="{Binding IsEditing}"
                Text="Архивировать"
                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
